{
  "manifest_version": 3,
  "name": "TranslatorX",
  "version": "1.5.14",
  "minimum_chrome_version": "116",
  "description": "TranslatorX turns YouTube videos into bilingual transcripts, AI overviews, and timestamped notes.",
  "homepage_url": "https://github.com/shawnzhang-lab/translatorx",
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.supadata.ai/*",
    "https://api.deepseek.com/*"
  ],
  "action": {
    "default_title": "Open TranslatorX",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["ui-language.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/translatorx-button-avatar-48.png",
        "icons/translatorx-success-ok-48.png"
      ],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
